# =============================================================================
# Project Critical Orbit — .env.example
# Copy to `.env` (or let scripts/setup-squadron.sh write it for you).
#
# SECURITY RULE: this file — and your generated `.env` — must contain ONLY
# endpoints and identifiers. NO keys, NO secrets, NO connection strings with
# credentials. All authentication is via Microsoft Entra ID
# (DefaultAzureCredential / `az login`).
# =============================================================================

# --- Team identity -----------------------------------------------------------
TEAM_ID=00                                   # two-digit squadron id, e.g. 07
AZURE_RESOURCE_GROUP=rg-corbit-sq00          # your squadron's resource group
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=swedencentral

# --- Microsoft Foundry -------------------------------------------------------
# Format: https://<ai-services-account>.services.ai.azure.com/api/projects/<project>
# Only needed for the Day-3 Foundry Agent Service stretch backend.
FOUNDRY_PROJECT_ENDPOINT=https://ais-corbit-00-xxxxxx.services.ai.azure.com/api/projects/prj-corbit-00
FOUNDRY_PROJECT_NAME=prj-corbit-00
# AIServices endpoint: https://<ai-services-account>.cognitiveservices.azure.com/
AZURE_AI_ENDPOINT=https://ais-corbit-00-xxxxxx.cognitiveservices.azure.com/
# OpenAI data-plane endpoint used for ALL chat + embedding calls:
# https://<ai-services-account>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://ais-corbit-00-xxxxxx.openai.azure.com/

# --- Model deployments (names, not keys) -------------------------------------
CHAT_MODEL_DEPLOYMENT=gpt-4.1
EMBEDDING_MODEL_DEPLOYMENT=text-embedding-3-large
# Expected embedding vector dimensions (3072 for text-embedding-3-large).
# day1/02_index_flight_manuals.py fails fast if the deployed model disagrees.
EXPECTED_EMBEDDING_DIMS=3072

# --- Azure AI Search ----------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://srch-corbit-00-xxxxxx.search.windows.net
AZURE_SEARCH_INDEX_NAME=flight-manuals

# --- Other squadron resources (identifiers only) ------------------------------
STORAGE_ACCOUNT_NAME=stcorbit00xxxxxx
STORAGE_CONTAINER_NAME=lab-data
KEY_VAULT_NAME=kv-corbit-00-xxxxxx

# --- Day 3 safety switches ----------------------------------------------------
# Real write-capable tools are DISABLED by default. Only the trainer may enable
# this; even then every write requires interactive human approval.
ENABLE_WRITE_TOOLS=false
