# Project Critical Orbit — universal editor settings.
# Read natively by most editors/IDEs (VS Code via EditorConfig extension,
# JetBrains, Neovim, Visual Studio). Keep this in sync with CI linting.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{bicep,sh,bash}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
