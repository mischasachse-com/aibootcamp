# =============================================================================
# Containers Track — .env.example
# Identifiers and endpoints ONLY. NO keys, NO secrets — auth is Entra-only
# (DefaultAzureCredential: `az login` locally, managed identity in Azure).
# =============================================================================

# --- Squadron stack (same values as the repo-root .env written by
#     scripts/setup-squadron.sh — copy them across, don't retype) --------------
TEAM_ID=00
AZURE_RESOURCE_GROUP=rg-corbit-sq00
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=swedencentral

AZURE_OPENAI_ENDPOINT=https://ais-corbit-00-xxxxxx.openai.azure.com/
AZURE_SEARCH_ENDPOINT=https://srch-corbit-00-xxxxxx.search.windows.net
AZURE_SEARCH_INDEX_NAME=flight-manuals
FOUNDRY_PROJECT_ENDPOINT=https://ais-corbit-00-xxxxxx.services.ai.azure.com/api/projects/prj-corbit-00
# ^ only needed if you run the Day-3 Foundry stretch backend — the container
#   variant uses the manual agent loop and does NOT require it.

CHAT_MODEL_DEPLOYMENT=gpt-4.1
EMBEDDING_MODEL_DEPLOYMENT=text-embedding-3-large
EXPECTED_EMBEDDING_DIMS=3072

# --- Container app settings ---------------------------------------------------
PORT=8000                     # port the app listens on (Dockerfile default)

# --- Day 2 -------------------------------------------------------------------
# Defaults resolve data/ under the repo-mirrored /app layout; only set these
# to point at a mounted volume instead.
# BLACKBOX_DATA_PATH=/app/data/blackbox/telemetry_dump_corrupted.json
# NSG_EXPORT_PATH=/app/data/blackbox/nsg_export_ground_station.json
# TOPOLOGY_IMAGE_PATH=/app/data/blackbox/orbital_mesh_topology.png

# --- Day 3 -------------------------------------------------------------------
AUDIT_LOG_PATH=/app/audit/audit_log.jsonl   # mount -v ./audit:/app/audit to persist
# INCIDENTS_DIR=/app/data/incidents
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_ITER=8
# Write tools stay simulated in the container: even ENABLE_WRITE_TOOLS=true is
# auto-denied by the headless approval gate (no TTY). Leave unset.
# ENABLE_WRITE_TOOLS=false
# HEADLESS=true                  # force write-gate auto-deny even with a TTY
